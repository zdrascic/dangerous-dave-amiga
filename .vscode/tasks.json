{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "args": [
                "-j4",
            ],
            "windows": {
                "command": "${command:amiga.bin-path}\\gnumake.exe",
                "options": {
                    "cwd": "${workspaceRoot}",
                    "env": {
                        "PATH": "C:\\amiga-gcc\\bin;${command:amiga.bin-path};C:\\Windows\\System32;C:\\Windows"
                    }
                }
            },
            "linux": {
                "command": "make",
                "options": {
                    "cwd": "${workspaceRoot}"
                }
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": "absolute"
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}